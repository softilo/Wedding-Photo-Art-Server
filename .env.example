PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/softilo_events?schema=public"
PG_POOL_MAX=5
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
CORS_ORIGINS="http://localhost:3000,https://your-frontend-domain.example.com"
OBSERVE_APP_KEY="YOUR_APP_KEY"
OBSERVE_APP_SECRET="YOUR_APP_SECRET"

# Seed credentials live in .env.seed (see .env.seed.example)

# Cloudinary Portfolio Showcase Media (see docs/EXTERNAL_SERVICES.md)
CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_FOLDER_PREFIX="softilo/portfolio"
PORTFOLIO_ALLOWED_IMAGE_FORMATS="jpg,jpeg,png,webp,avif,heic"
PORTFOLIO_ALLOWED_VIDEO_FORMATS="mp4,webm,mov"
PORTFOLIO_MAX_IMAGE_BYTES=15728640
PORTFOLIO_MAX_VIDEO_BYTES=104857600

