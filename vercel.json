{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{pdfkit/js/standard-fonts/**,.pnpm/pdfkit@*/node_modules/pdfkit/js/standard-fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api?__vercel_path=$1"
    }
  ]
}
